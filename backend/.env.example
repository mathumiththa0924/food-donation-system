PORT=5000
MONGO_URI=mongodb://localhost:27017/foodDonationDB
JWT_SECRET=replace_with_a_strong_secret_key

# Canonical admin account (optional overrides — defaults in config/adminConfig.js)
ADMIN_EMAIL=adminmealbridge@gmail.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=MealBridge Admin
# Set in production to protect POST /api/admin/setup-admin
# ADMIN_SETUP_SECRET=your_random_setup_secret

# Optional SMTP settings for real email delivery.
# If these are not set, the app will use Ethereal test email previews in development.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="MealBridge Admin" <adminmealbridge@gmail.com>
